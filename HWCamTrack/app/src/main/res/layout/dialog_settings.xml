<?xml version="1.0" encoding="utf-8"?>
<!-- 检测设置对话框：检测器 / 分析帧率 / 最小告警面积 / 对称检测，以及取流与显示开关 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <!-- 语言放在最上面：它一改整个界面就重建，用户第一眼就能找到 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/language_label"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:minHeight="44dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_detector"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spDetector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:minHeight="44dp" />

        <TextView
            android:id="@+id/tvFpsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            tools:text="分析帧率：5 fps" />

        <SeekBar
            android:id="@+id/sbFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="14" />

        <TextView
            android:id="@+id/tvMinAreaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbMinArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="49" />

        <!-- 报警声时长 + 试听 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAlarmDurationLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface"
                android:textSize="13sp"
                tools:text="报警声持续时长：3 秒（1~10 秒）" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestSound"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/action_test_sound" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbAlarmDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swSymmetric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/switch_symmetric"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swShowTracking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/switch_tracking"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swRtpTcp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/switch_rtp_tcp"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swSoftwareDecode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/switch_software_decode"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_help"
            android:textColor="@color/on_surface_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
